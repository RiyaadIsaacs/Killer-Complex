  continueButton: {fileID: 1379841683813544698}
  title: Tonight
  body: "Your wife is missing. Whoever took her left your apartment computer running\u2014a
    messenger contact who calls himself H has her held off-site.\n\nHe is forcing
    you to run urgent package deliveries for his customers across this complex tonight.
    Pick up each package somewhere in the building, deliver it to the unit he names,
    and check in on the computer before his patience runs out.\n\nWhen you are ready,
    head to the computer. He will reach out with your first job."
  continueHint: Continue  (click, Space, or Enter)
  playerController: {fileID: 0}
  freezeTimeWhileVisible: 1
